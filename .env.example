# Postgres connection (the app owns this database)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/content_pilot

# better-auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3010

# GitHub fine-grained PAT with Contents read/write on the client repos.
# Also used by the API routes to resolve owner/repo from a repoId
# (GET /repositories/{id}) the first time an unknown repo submits an edit.
GITHUB_PAT=

# HMAC secret for hub-minted canvas-editor edit tokens accepted by the intake.
# MUST match the hub api app's EDIT_TOKEN_SECRET (generate: openssl rand -base64 32).
EDIT_TOKEN_SECRET=

# Where client repos are cloned (persistent volume in Docker: /data/workspace)
WORKSPACE_DIR=./workspace

# Worker tuning
POLL_INTERVAL_MS=300000
JOB_TIMEOUT_MS=600000
CLAUDE_BIN=claude
# Model for edits: haiku (fast/cheap, recommended), sonnet, or opus
CLAUDE_MODEL=haiku

# Git identity used for AI edit commits
GIT_AUTHOR_NAME=AI Edit Bot
GIT_AUTHOR_EMAIL=ai-edits@localhost

# ---------------------------------------------------------------------------
# Live-preview AI sessions (src/preview supervisor)
# ---------------------------------------------------------------------------
# Preview URL template; {id} is the session id. The proxy routes by the
# leftmost Host label in both environments.
#   local: http://{id}.localhost:3020   (browsers resolve *.localhost natively)
#   prod:  https://{id}.preview.alisamadii.com
PREVIEW_URL_BASE=http://{id}.localhost:3020
PREVIEW_PROXY_PORT=3020
PREVIEW_PORT_MIN=4100
PREVIEW_PORT_MAX=4109
MAX_PREVIEW_SESSIONS=3
SESSION_IDLE_MINUTES=30
INSTALL_TIMEOUT_MS=300000
DEV_READY_TIMEOUT_MS=120000
SESSION_MESSAGE_TIMEOUT_MS=600000
# Conversational edits need more model than the overlay's one-shot haiku.
SESSION_CLAUDE_MODEL=sonnet

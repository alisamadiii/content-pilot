# Postgres connection (the app owns this database)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/content_pilot

# better-auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3010

# GitHub App ("Ali Samadi App") — the ONLY GitHub credential. Per-repo
# installation tokens are minted for every clone/push; a repo without the app
# installed cannot be edited. GITHUB_APP_PRIVATE_KEY is the base64 of GitHub's
# PKCS#1 PEM (single line):
#   base64 < ali-samadi-app.private-key.pem | tr -d '\n'
# Key rotation: generate a new key in GitHub, swap the env, redeploy — cached
# tokens keep working until expiry, so rotation is zero-downtime.
# Both empty = local dev only (git uses the system credential helper).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# HMAC secret for hub-minted canvas-editor edit tokens accepted by the intake.
# MUST match the hub api app's EDIT_TOKEN_SECRET (generate: openssl rand -base64 32).
EDIT_TOKEN_SECRET=

# Where client repos are cloned (persistent volume in Docker: /data/workspace)
WORKSPACE_DIR=./workspace

# Worker tuning
POLL_INTERVAL_MS=300000
JOB_TIMEOUT_MS=600000
CLAUDE_BIN=claude
# Model for edits: haiku (fast/cheap, recommended), sonnet, or opus
CLAUDE_MODEL=haiku

# Git identity used for AI edit commits
GIT_AUTHOR_NAME=AI Edit Bot
GIT_AUTHOR_EMAIL=ai-edits@localhost

# ---------------------------------------------------------------------------
# Live-preview AI sessions (src/preview supervisor)
# ---------------------------------------------------------------------------
# Preview URL template; {id} is the session id. The proxy routes by the
# leftmost Host label in both environments.
#   local: http://{id}.localhost:3020   (browsers resolve *.localhost natively)
#   prod:  https://{id}.preview.alisamadii.com
PREVIEW_URL_BASE=http://{id}.localhost:3020
PREVIEW_PROXY_PORT=3020
PREVIEW_PORT_MIN=4100
PREVIEW_PORT_MAX=4109
MAX_PREVIEW_SESSIONS=3
SESSION_IDLE_MINUTES=30
INSTALL_TIMEOUT_MS=300000
DEV_READY_TIMEOUT_MS=120000
SESSION_MESSAGE_TIMEOUT_MS=600000
# Conversational edits need more model than the overlay's one-shot haiku.
SESSION_CLAUDE_MODEL=sonnet
# Anthropic API key for preview sessions (Agent SDK). Metered billing — no CLI login.
ANTHROPIC_API_KEY=

# Gemini is the DEFAULT provider (cheap); Claude is opt-in per paying project
# via the `ai_provider:<repoId>` app_setting. Gemini CLI, AI Studio key, no OAuth.
# The CLI runs from an isolated home (<WORKSPACE_DIR>/.gemini-home: trimmed tool
# set, LOW thinking, our own system prompt) — see src/preview/gemini-setup.ts.
# Measure a message's cost: pnpm exec tsx scripts/gemini-probe.ts <repoId> "<msg>"
GEMINI_API_KEY=
# Optional paid-tier Gemini key. Workspaces toggled "paid" in the admin
# (gemini_tier:<repoId>) use this key; everything else uses GEMINI_API_KEY.
GEMINI_API_KEY_PAID=
SESSION_GEMINI_MODEL=gemini-3.1-flash-lite
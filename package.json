{
  "name": "content-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI content editor: clients chat with a live preview session, Claude/Gemini apply edits, git push deploys on publish.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "node scripts/build-analyzer.mjs && next build",
    "start": "next start -p 3010",
    "build:analyzer": "node scripts/build-analyzer.mjs",
    "preview": "tsx src/preview/index.ts",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.45.3",
    "http-proxy": "^1.18.1",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0"
}
{
  "name": "content-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI content-edit runner: clients request changes, Claude Code applies them, git push deploys.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "worker": "tsx src/worker/index.ts",
    "preview": "tsx src/preview/index.ts",
    "db:push": "drizzle-kit push",
    "seed": "tsx scripts/seed-job.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.45.3",
    "http-proxy": "^1.18.1",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0"
}